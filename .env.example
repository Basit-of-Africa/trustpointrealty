# Postgres connection string (Neon in production, local Postgres in dev)
DATABASE_URL=postgres://trustpoint:trustpoint@localhost:5432/trustpoint
# Public URL of the portal, used in referral and password-reset links
APP_URL=http://localhost:3000
# Optional: Resend API key for password-reset emails. Without it, links are logged to the console.
RESEND_API_KEY=
EMAIL_FROM=TrustPoint Realty <no-reply@trustpointrealty.ng>
# Optional: email address that receives website "Request a Quote" notifications (needs RESEND_API_KEY)
ENQUIRY_NOTIFY_EMAIL=
